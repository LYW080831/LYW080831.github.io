<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>点赞交互 Demo（模拟）</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  .card {
    width: 300px;
    border-radius: 16px;
    overflow: hidden;
    background: #1c1c1e;
    box-shadow: 0 12px 40px rgba(0,0,0,.6);
    position: relative;
  }

  .cover {
    height: 400px;
    background: linear-gradient(135deg, #2b2b33, #4a4a58);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
    font-size: 14px;
  }

  .side {
    position: absolute;
    right: 12px;
    bottom: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .like-btn {
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,.12);
    backdrop-filter: blur(6px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform .15s ease, background .2s;
    position: relative;
  }
  .like-btn:hover { background: rgba(255,255,255,.2); }
  .like-btn:active { transform: scale(.88); }

  .like-btn svg {
    width: 26px;
    height: 26px;
    fill: #fff;
    transition: fill .2s;
  }

  .like-btn.liked svg { fill: #fe2c55; }

  .like-btn.pop { animation: pop .45s ease; }
  @keyframes pop {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.35); }
    60%  { transform: scale(.92); }
    100% { transform: scale(1); }
  }

  .count {
    color: #fff;
    font-size: 12px;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  /* 飘心特效 */
  .heart {
    position: absolute;
    left: 50%;
    bottom: 100%;
    font-size: 16px;
    pointer-events: none;
    animation: floatUp .9s ease-out forwards;
  }
  @keyframes floatUp {
    0%   { opacity: 1; transform: translate(-50%, 0) scale(.5) rotate(0deg); }
    100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), -90px) scale(1.3) rotate(var(--rot)); }
  }
</style>
</head>
<body>

<div class="card">
  <div class="cover">视频区域（占位）</div>

  <div class="side">
    <div style="text-align:center;">
      <button class="like-btn" id="likeBtn" aria-pressed="false" aria-label="点赞">
        <svg viewBox="0 0 24 24">
          <path d="M12 21s-7.5-4.7-9.7-9.1C.7 8.6 2.3 5 5.7 4.3c2-.4 4 .5 5.1 2.2h2.4c1.1-1.7 3.1-2.6 5.1-2.2 3.4.7 5 4.3 3.4 7.6C19.5 16.3 12 21 12 21z"/>
        </svg>
      </button>
      <div class="count" id="likeCount">1.2w</div>
    </div>
  </div>
</div>

<script>
(function () {
  const btn   = document.getElementById('likeBtn');
  const count = document.getElementById('likeCount');

  let liked = false;
  let base  = 12000;   // 假装的基础点赞数

  // 数字格式化：12000 -> 1.2w
  function fmt(n) {
    if (n < 10000) return String(n);
    return (n / 10000).toFixed(1).replace(/\.0$/, '') + 'w';
  }

  // 生成飘心
  function spawnHearts(n) {
    for (let i = 0; i < n; i++) {
      const h = document.createElement('span');
      h.className = 'heart';
      h.textContent = ['❤️', '💗', '💖'][i % 3];
      h.style.setProperty('--dx',  (Math.random() * 60 - 30).toFixed(0) + 'px');
      h.style.setProperty('--rot', (Math.random() * 60 - 30).toFixed(0) + 'deg');
      h.style.animationDelay = (i * 60) + 'ms';
      btn.appendChild(h);
      setTimeout(() => h.remove(), 1000 + i * 60);
    }
  }

  function update() {
    btn.classList.toggle('liked', liked);
    btn.setAttribute('aria-pressed', liked);
    count.textContent = fmt(base + (liked ? 1 : 0));
  }

  btn.addEventListener('click', () => {
    liked = !liked;
    update();

    if (liked) {
      // 重新触发 pop 动画
      btn.classList.remove('pop');
      void btn.offsetWidth;
      btn.classList.add('pop');
      spawnHearts(5);
    }
  });

  update();
})();
</script>

</body>
</html>
